# Copy to .env and fill in locally. Agents never read .env; they run `just db-check`.
# Preferred: store broker secrets in the macOS Keychain with `just set-secret kite_api_key` (human-only); .env is a development fallback only.
# Never commit .env. Execution mode lives only in config/risk.toml. Bazaar binds 127.0.0.1 only (no bind setting).

RUST_LOG=
BAZAAR_PORT=8787
BAZAAR_DATA_DIR=
BAZAAR_CONFIG_DIR=

# Zerodha Kite Connect. Redirect URL in the Kite developer console: http://127.0.0.1:8787/api/v1/kite/callback
# (the daily access token is obtained through the login flow and kept in the Keychain)
KITE_API_KEY=
KITE_API_SECRET=

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
