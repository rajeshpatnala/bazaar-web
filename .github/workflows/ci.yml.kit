# Minimal starting point. `cicd` upgrades it to the reference workflow in fe-cicd-observability (references/ci.md).
name: ci
on:
  pull_request:
  merge_group:
  push:
    branches: [main, develop]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  pr-title:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      pull-requests: read
    steps:
      - uses: amannn/action-semantic-pull-request@v5   # Conventional Commit PR titles -> changelog
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - if: hashFiles('package.json') != ''
        uses: pnpm/action-setup@v4
      - if: hashFiles('package.json') != ''
        uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - if: hashFiles('package.json') != ''
        run: pnpm install --frozen-lockfile
      - if: hashFiles('package.json') != ''
        run: pnpm verify

  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - if: hashFiles('pnpm-lock.yaml') != ''
        uses: pnpm/action-setup@v4
      - if: hashFiles('pnpm-lock.yaml') != ''
        run: pnpm audit --prod --audit-level high
